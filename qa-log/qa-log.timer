[Unit]
Description=주간 Claude QA 로그 — 매주 월요일 (놓치면 다음 부팅 시 실행)

[Timer]
# 매주 월요일 10:00 (시스템 로컬 시간 = KST)
OnCalendar=Mon 10:00
# 월요일에 컴퓨터가 꺼져 있었으면 다음 부팅/로그인 시점에 즉시 밀린 실행을 수행
Persistent=true
AccuracySec=1min
# 부팅 직후 몰림을 피해 2분 랜덤 지연
RandomizedDelaySec=2min
Unit=qa-log.service

[Install]
WantedBy=timers.target
